{% extends "govuk/template.njk" %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}

{% set mainClasses = "app-main-wrapper" %}

{% block head %}
  <link href="{{ getAssetPath('src/client/stylesheets/application.scss') }}" rel="stylesheet">
{% endblock %}

{% block header %}
  <header class="defra-header" role="banner">
    <div class="defra-header__inner">
    <div class="defra-header__brand-group">
      <img
        src="{{ getAssetPath('src/client/images/defra-logo.svg') }}"
        alt="Department for Environment, Food &amp; Rural Affairs"
        class="defra-header__logo"
      />
      <a href="/" class="defra-header__service-name">{{ serviceName }}</a>
    </div>
    <div class="defra-header__account">
      {% if isAuthenticated %}
        <svg class="defra-header__account-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="12" fill="currentColor" />
          <circle cx="12" cy="9.5" r="3.5" fill="#ffffff" />
          <path fill="#ffffff" d="M4.5 19.5c1.2-3.2 4-5 7.5-5s6.3 1.8 7.5 5c-1.9 2-4.6 3-7.5 3s-5.6-1-7.5-3z" />
        </svg>
        {% if userDisplayName %}
          <span class="defra-header__account-name">{{ userDisplayName }}</span>
          <span class="defra-header__account-divider" aria-hidden="true"></span>
        {% endif %}
        <a href="/logout" class="defra-header__account-link">Sign out</a>
      {% else %}
        <a href="/" class="defra-header__account-link">Sign in</a>
      {% endif %}
    </div>
    </div>
  </header>

  {% if isAuthenticated %}
    <nav class="defra-service-navigation" aria-label="Site navigation" data-module="defra-service-navigation">
      <div class="defra-service-navigation__inner">
        <button
          type="button"
          class="defra-service-navigation__toggle js-service-navigation-toggle"
          aria-controls="site-navigation-list"
          aria-expanded="false"
          hidden
        >Menu</button>
        <ul class="defra-service-navigation__list" id="site-navigation-list">
          <li class="defra-service-navigation__item">
            <a class="defra-service-navigation__link" href="/dashboard" {% if currentUrl == '/dashboard' %}aria-current="page"{% endif %}>Dashboard</a>
          </li>
          <li class="defra-service-navigation__item">
            <a class="defra-service-navigation__link" href="/approvals" {% if currentUrl and currentUrl.startsWith('/approvals') %}aria-current="page"{% endif %}>My approvals</a>
          </li>
          <li class="defra-service-navigation__item">
            <a class="defra-service-navigation__link" href="/space-requests/new" {% if currentUrl and currentUrl.startsWith('/space-requests') %}aria-current="page"{% endif %}>Request a space</a>
          </li>
        </ul>
      </div>
    </nav>
  {% endif %}
{% endblock %}

{% block pageTitle %}
  {{ pageTitle if pageTitle else serviceName }} | {{ serviceName }}
{% endblock %}

{% block beforeContent %}
  {% if breadcrumbs %}
    <div class="govuk-width-container govuk-!-margin-bottom-3">
      {{ govukBreadcrumbs({ items: breadcrumbs }) }}
    </div>
  {% endif %}
{% endblock %}

{% block content %}
{% endblock %}

{% block footer %}
  <footer class="defra-footer" role="contentinfo">
    <div class="govuk-width-container">
      {% if aceSlackChannel %}
        <p class="govuk-body-s govuk-!-margin-top-3 govuk-!-margin-bottom-0">
          Questions? Contact the AICE team on Slack <a class="defra-footer__link" href="{{ aceSlackChannel }}">#ask-ace</a>
        </p>
      {% endif %}
    </div>
  </footer>
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="{{ getAssetPath('src/client/javascripts/application.js') }}"></script>
{% endblock %}
