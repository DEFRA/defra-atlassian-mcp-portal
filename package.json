{
  "name": "jira-mcp-portal",
  "version": "0.0.0",
  "description": "CDP Frontend Template",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "git:pre-commit-hook": "npm run lint",
    "git:setup-hooks": "husky",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --use-strict ./src/index.js",
    "start:dev": "NODE_ENV=development run-p build:watch server:watch",
    "dev": "npm run start:dev",
    "server:watch": "nodemon --env-file-if-exists=.env --watch src --watch .public --ext js,njk,yaml,json --ignore src/client --exec 'node --env-file-if-exists=.env --use-strict ./src/index.js'",
    "lint": "run-s lint:js lint:scss",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "test": "TZ=UTC run-s lint build test:js",
    "test:js": "TZ=UTC vitest run --coverage"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@defra/cdp-auditing": "0.6.1",
    "@defra/cdp-metrics": "0.6.0",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/bell": "13.2.0",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/catbox-redis": "7.1.0",
    "@hapi/cookie": "12.0.1",
    "@hapi/hapi": "21.4.10",
    "@hapi/inert": "7.1.2",
    "@hapi/jwt": "3.2.4",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/wreck": "18.1.2",
    "@hapi/yar": "11.0.3",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "date-fns": "4.4.0",
    "flatted": "3.4.4",
    "govuk-frontend": "6.5.1",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "ioredis": "6.0.0",
    "joi": "18.2.9",
    "jwks-rsa": "4.1.0",
    "lodash": "4.18.1",
    "marked": "18.0.14",
    "node-fetch": "3.3.2",
    "nunjucks": "3.2.4",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "semver": "7.8.5",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.1",
    "autoprefixer": "10.6.1",
    "cssnano": "9.0.5",
    "cssnano-preset-default": "9.0.5",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "neostandard": "0.13.0",
    "nock": "14.0.17",
    "nodemon": "3.1.14",
    "npm-run-all2": "9.0.3",
    "postcss-load-config": "6.0.1",
    "postcss-loader": "8.2.1",
    "sass-embedded": "1.104.1",
    "sass-loader": "17.0.1",
    "sharp": "0.35.4",
    "source-map-loader": "5.0.0",
    "stylelint": "17.15.0",
    "stylelint-config-gds": "3.0.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vitest-fetch-mock": "0.4.5"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.8",
    "immutable": "5.1.9",
    "js-yaml": "4.3.1",
    "joi": "18.2.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "shell-quote": "1.10.0",
    "svgo": "4.1.0"
  }
}
